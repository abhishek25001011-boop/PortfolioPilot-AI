# Ollama must be running locally. Select any Ollama-compatible open-weight model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen-coder:latest
OLLAMA_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional public FastAPI origin for separately hosted frontend builds.
# Leave empty for the local Vite proxy.
VITE_API_BASE_URL=
